// Filters are links, so the URL builder IS the filter UI: if these break, the store
// silently loses state between clicks.
import src/urls;
import src/catalog;

fn base() -> catalog.Query {
    catalog.empty_query()
}

@test
fn an_untouched_query_is_the_bare_catalog_url() {
    assert_eq(urls.catalog_url(base()), "/catalogo");
}

@test
fn values_are_percent_encoded() {
    var q = base();
    q.search = "auriculares pro";
    q.colors = ["Azul noche"];
    assert_eq(urls.catalog_url(q), "/catalogo?q=auriculares%20pro&color=Azul%20noche");
}

@test
fn toggling_a_brand_adds_it_and_toggling_again_removes_it() {
    let q = base();
    let with_one = urls.toggle_brand(q, "nordis");
    assert_eq(with_one, "/catalogo?marca=nordis");
    var picked = base();
    picked.brands = ["nordis", "lumen"];
    assert_eq(urls.toggle_brand(picked, "nordis"), "/catalogo?marca=lumen");
}

@test
fn choosing_the_active_category_again_clears_it() {
    var q = base();
    q.category = "audio";
    assert_eq(urls.with_category(q, "audio"), "/catalogo");
    assert_eq(urls.with_category(q, "photo"), "/catalogo?categoria=photo");
}

@test
fn changing_a_filter_sends_you_back_to_the_first_page() {
    var q = base();
    q.page = 4;
    q.category = "audio";
    assert_eq(urls.toggle_brand(q, "volt"), "/catalogo?categoria=audio&marca=volt");
}

@test
fn paging_keeps_every_other_filter() {
    var q = base();
    q.category = "audio";
    q.colors = ["Negro"];
    q.on_sale = true;
    assert_eq(urls.with_page(q, 3), "/catalogo?categoria=audio&color=Negro&oferta=1&pagina=3");
}

@test
fn prices_travel_as_whole_euros() {
    var q = base();
    q.min_cents = 5000;
    q.max_cents = 129900;
    assert_eq(urls.catalog_url(q), "/catalogo?min=50&max=1299");
    assert_eq(urls.without_price(q), "/catalogo");
}

@test
fn the_default_sort_is_not_spelled_out_in_the_url() {
    let q = base();
    assert_eq(urls.with_sort(q, "featured"), "/catalogo");
    assert_eq(urls.with_sort(q, "rating"), "/catalogo?orden=rating");
}

@test
fn the_hidden_state_fields_escape_what_they_carry() {
    var q = base();
    q.colors = ["A\"B"];
    assert(urls.state_fields(q).contains("&quot;"));
}
