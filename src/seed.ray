// The demo catalog: categories, brands, products with their variants (color x size) and
// their technical sheet. Everything is deterministic — no randomness — so two runs of
// `ray run reseed` produce byte-identical data.
import db/sqlite;
import src/database;
import src/palette;
import std/time;

struct SeedProduct {
    slug: string,
    name: string,
    tagline: string,
    description: string,
    category: string,
    brand: string,
    price_cents: int,
    compare_at_cents: int,
    rating: int,
    reviews: int,
    badge: string,
    featured: bool,
    colors: [string],
    sizes: [string],
    size_step_cents: int,
    features: [[string]],
}

fn categories() -> [[string]] {
    [
        ["audio", "Audio", "Sonido que se siente, no solo se escucha", "headphones"],
        ["wearables", "Wearables", "Tu dia a dia, medido al detalle", "watch"],
        ["computing", "Informatica", "Potencia silenciosa para trabajar y crear", "laptop"],
        ["photo", "Fotografia", "Optica y luz para contar historias", "camera"],
        ["home", "Hogar inteligente", "Una casa que se adelanta a ti", "home"],
        ["fitness", "Fitness", "Entrena mejor, no mas", "activity"],
    ]
}

