// Domain types of the store. Every type that crosses the JSON API implements `ToJson`:
// the flat ones derive it, the aggregates (which carry arrays) build it with the
// `std/json` builder so the escaping is correct by construction.
from std/json import ToJson, obj, field, list, render, Obj;

// NOTE on JSON keys: `@derive(ToJson)` names the keys after the raylang fields, which are
// snake_case. The API speaks camelCase, so every type with a multi-word field writes its
// own `to_json` — deriving it would ship `price_cents` and quietly break the TypeScript
// client (a missing `priceCents` shows up as `NaN €`, not as an error).
/// A manufacturer. Products belong to exactly one.
@derive(Eq, Show)
pub struct Brand {
    id: int,
    slug: string,
    name: string,
    tagline: string,
    product_count: int,
}

/// A top level section of the catalog.
@derive(Eq, Show)
pub struct Category {
    id: int,
    slug: string,
    name: string,
    tagline: string,
    icon: string,
    product_count: int,
}

/// A buyable combination of options (color + size) of a product.
@derive(Eq, Show)
pub struct Variant {
    id: int,
    product_id: int,
    sku: string,
    color: string,
    color_hex: string,
    size: string,
    price_cents: int,
    stock: int,
}

impl ToJson for Brand {
    fn to_json(self) -> string {
        render(obj()
            .field("id", self.id)
            .field("slug", self.slug)
            .field("name", self.name)
            .field("tagline", self.tagline)
            .field("productCount", self.product_count))
    }
}

impl ToJson for Category {
    fn to_json(self) -> string {
        render(obj()
            .field("id", self.id)
            .field("slug", self.slug)
            .field("name", self.name)
            .field("tagline", self.tagline)
            .field("icon", self.icon)
            .field("image", "/img/category/" + self.slug + ".svg")
            .field("productCount", self.product_count))
    }
}

impl ToJson for Variant {
    fn to_json(self) -> string {
        render(obj()
            .field("id", self.id)
            .field("productId", self.product_id)
            .field("sku", self.sku)
            .field("color", self.color)
            .field("colorHex", self.color_hex)
            .field("size", self.size)
            .field("priceCents", self.price_cents)
            .field("stock", self.stock))
    }
}

/// One row of the technical sheet ("Material" -> "Aluminio reciclado").
@derive(ToJson, Eq, Show)
pub struct Feature {
    name: string,
    value: string,
}

/// A catalog entry. `rating` is stored in tenths (47 = 4.7 stars) so the whole
/// model stays integer-only and comparisons are exact.
pub struct Product {
    id: int,
    slug: string,
    name: string,
    tagline: string,
    description: string,
    category_slug: string,
    category_name: string,
    brand_slug: string,
    brand_name: string,
    price_cents: int,
    compare_at_cents: int,
    rating: int,
    reviews: int,
    badge: string,
    featured: bool,
    stock: int,
    colors: [string],
    sizes: [string],
    variants: [Variant],
    features: [Feature],
}

impl ToJson for Product {
    fn to_json(self) -> string {
        render(obj()
            .field("id", self.id)
            .field("slug", self.slug)
            .field("name", self.name)
            .field("tagline", self.tagline)
            .field("description", self.description)
            .field("categorySlug", self.category_slug)
            .field("categoryName", self.category_name)
            .field("brandSlug", self.brand_slug)
            .field("brandName", self.brand_name)
            .field("priceCents", self.price_cents)
            .field("compareAtCents", self.compare_at_cents)
            .field("rating", self.rating)
            .field("reviews", self.reviews)
            .field("badge", self.badge)
            .field("featured", self.featured)
            .field("stock", self.stock)
            .field("image", "/img/product/" + self.slug + ".svg")
            .field("colors", list(self.colors))
            .field("sizes", list(self.sizes))
            .field("variants", list(self.variants))
            .field("features", list(self.features)))
    }
}

/// One line of the shopping cart, already resolved against the catalog.
pub struct CartLine {
    variant_id: int,
    product_slug: string,
    product_name: string,
    color: string,
    color_hex: string,
    size: string,
    unit_cents: int,
    quantity: int,
    stock: int,
}

impl ToJson for CartLine {
    fn to_json(self) -> string {
        render(obj()
            .field("variantId", self.variant_id)
            .field("productSlug", self.product_slug)
            .field("productName", self.product_name)
            .field("color", self.color)
            .field("colorHex", self.color_hex)
            .field("size", self.size)
            .field("unitCents", self.unit_cents)
            .field("quantity", self.quantity)
            .field("stock", self.stock)
            .field("image", "/img/product/" + self.product_slug + ".svg")
            .field("lineCents", self.unit_cents * self.quantity))
    }
}

/// The cart as a whole, with the totals already computed.
pub struct Cart {
    lines: [CartLine],
    units: int,
    subtotal_cents: int,
    shipping_cents: int,
    total_cents: int,
}

impl ToJson for Cart {
    fn to_json(self) -> string {
        render(obj()
            .field("lines", list(self.lines))
            .field("units", self.units)
            .field("subtotalCents", self.subtotal_cents)
            .field("shippingCents", self.shipping_cents)
            .field("totalCents", self.total_cents))
    }
}

/// The distinct values available for a facet, with how many products carry each.
@derive(ToJson, Eq, Show)
pub struct FacetValue {
    value: string,
    label: string,
    hex: string,
    count: int,
}
