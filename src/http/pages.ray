// The public storefront: home, catalog, deals and the product detail. Each handler is a
// straight line of `?` that ends in a `Reply`; opening and closing the database, the 500
// and the 404 are `respond.with_db`'s job.
from web/framework import Ctx, Res, param, query;
import db/sqlite;
import src/store/catalog;
import src/store/schema;
import src/ui/view;
import src/domain/models;
import src/http/request;
import src/http/shell;
import src/http/respond;
from src/http/respond import Reply;
import views/home;
import views/catalog as catalog_view;
import views/product as product_view;

pub fn home(c: Ctx, r: Res) {
    respond.with_db(c, r, fn(conn: sqlite.Conn) -> Result<Reply, string> {
        let featured = catalog.featured(conn, 8)?;
        if (featured.len() == 0) {
            return Result.Err("catalogo vacio");
        }
        // The first featured product headlines the hero; the rest fill the rail.
        var rail: [models.Product] = [];
        for i in 1..featured.len() {
            rail.push(featured[i]);
        }
        let frame = shell.of(
            conn,
            c,
            "Tecnologia elegida a mano",
            "Audio, wearables, informatica y hogar inteligente con envio en 24 h.",
            "/"
        )?;
        Result.Ok(
            Reply.Html(
                home.render(
                    frame,
                    featured[0],
                    rail,
                    respond.or_empty(catalog.on_sale(conn, 4)),
                    respond.or_empty(catalog.newest(conn, 4)),
                    schema.product_count(conn)?
                )
            )
        )
    });
}

// Shared by /catalogo and /ofertas: same page, different starting filters and copy.
fn listing(c: Ctx, r: Res, q: catalog.Query, heading: string, subheading: string, path: string) {
    respond.with_db(c, r, fn(conn: sqlite.Conn) -> Result<Reply, string> {
        let page = catalog.search(conn, q)?;
        let facets = catalog.facets(conn, q)?;

        // The heading follows what the shopper actually asked for: their search terms
        // first, then the category, then the section they came from.
        var title = heading;
        for facet in facets.categories {
            if (facet.value == q.category) {
                title = facet.label;
            }
        }
        if (q.search.trim() != "") {
            title = "Resultados de “" + q.search + "”";
        }
        let noun = if (page.total == 1) { "producto" } else { "productos" };
        let counted = to_string(page.total) + " " + noun + " · " + subheading;
        var section = path;
        if (q.category != "") {
            section = "/c/" + q.category;
        }
        let frame = shell.of(conn, c, title, counted, section)?;
        Result.Ok(Reply.Html(catalog_view.render(frame, page, facets, q, title, counted)))
    });
}

pub fn catalog_page(c: Ctx, r: Res) {
    listing(
        c,
        r,
        request.query_of(c),
        "Todo el catalogo",
        "stock real, ficha tecnica completa y envio en 24 h.",
        "/catalogo"
    );
}

pub fn deals(c: Ctx, r: Res) {
    var q = request.query_of(c);
    q.on_sale = true;
    if (q.sort == "featured") {
        q.sort = "discount";
    }
    listing(c, r, q, "Semana Nova", "rebajados ahora mismo, ordenados por descuento.", "/ofertas");
}

pub fn product(c: Ctx, r: Res) {
    respond.with_db(c, r, fn(conn: sqlite.Conn) -> Result<Reply, string> {
        match (catalog.by_slug(conn, c.param("slug"))?) {
            Option.None => Result.Ok(Reply.Missing),
            Option.Some(found) => {
                let chosen = view.pick_variant(found, c.query("color"), c.query("talla"));
                let related = respond.or_empty(catalog.related(conn, found, 4));
                let frame = shell.of(
                    conn,
                    c,
                    found.name,
                    found.tagline,
                    "/c/" + found.category_slug
                )?;
                var notice = "";
                if (c.query("anadido") == "1") {
                    notice = "Anadido al carrito";
                }
                Result.Ok(Reply.Html(product_view.render(frame, found, chosen, related, notice)))
            },
        }
    });
}
