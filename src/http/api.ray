// The JSON API the Astro frontend and its React islands consume. Same data and same
// queries as the server-rendered store — only the shape of the answer differs.
//
// Keys are camelCase throughout: the types with multi-word fields write their `to_json`
// by hand (see `src/domain/models.ray`), because deriving it would emit snake_case.
from web/framework import Ctx, Res, param, query, form_field;
from std/json import obj, field, list, render, ToJson;
import db/sqlite;
import src/store/database;
import src/store/catalog;
import src/store/cart;
import src/store/schema;
import src/http/request;
import src/http/respond;
from src/http/respond import Reply;

pub fn products(c: Ctx, r: Res) {
    respond.with_db(c, r, fn(conn: sqlite.Conn) -> Result<Reply, string> {
        var q = request.query_of(c);
        q.per_page = request.int_or(c.query("porPagina"), 12);
        let page = catalog.search(conn, q)?;
        Result.Ok(
            Reply.Json(
                render(obj()
                    .field("items", list(page.items))
                    .field("total", page.total)
                    .field("page", page.page)
                    .field("perPage", page.per_page)
                    .field("pages", page.pages))
            )
        )
    });
}

pub fn product(c: Ctx, r: Res) {
    respond.with_db(c, r, fn(conn: sqlite.Conn) -> Result<Reply, string> {
        match (catalog.by_slug(conn, c.param("slug"))?) {
            Option.Some(found) => Result.Ok(Reply.Json(found.to_json())),
            Option.None => Result.Ok(Reply.JsonCoded(404, `{"error": "producto no encontrado"}`)),
        }
    });
}

pub fn taxonomy(c: Ctx, r: Res) {
    respond.with_db(c, r, fn(conn: sqlite.Conn) -> Result<Reply, string> {
        Result.Ok(
            Reply.Json(
                render(obj()
                    .field("categories", list(catalog.all_categories(conn)?))
                    .field("brands", list(catalog.all_brands(conn)?)))
            )
        )
    });
}

pub fn facets(c: Ctx, r: Res) {
    respond.with_db(c, r, fn(conn: sqlite.Conn) -> Result<Reply, string> {
        let found = catalog.facets(conn, request.query_of(c))?;
        Result.Ok(
            Reply.Json(
                render(obj()
                    .field("categories", list(found.categories))
                    .field("brands", list(found.brands))
                    .field("colors", list(found.colors))
                    .field("sizes", list(found.sizes))
                    .field("minCents", found.min_cents)
                    .field("maxCents", found.max_cents))
            )
        )
    });
}

pub fn basket(c: Ctx, r: Res) {
    respond.with_db(c, r, fn(conn: sqlite.Conn) -> Result<Reply, string> {
        Result.Ok(Reply.Json(cart.resolve(conn, request.cart_of(c))?.to_json()))
    });
}

/// The islands post here. The answer is the whole re-priced cart, so the client never has
/// to compute a total itself — and never gets to decide one either.
pub fn mutate_basket(c: Ctx, r: Res) {
    let action = c.param("action");
    let variant = request.int_or(c.form_field("variant"), 0);
    let quantity = request.int_or(c.form_field("quantity"), 1);
    let current = request.cart_of(c);
    var updated = current;
    if (action == "add") {
        updated = cart.add(current, variant, quantity);
    }
    if (action == "set") {
        updated = cart.set_quantity(current, variant, quantity);
    }
    if (action == "remove") {
        updated = cart.remove(current, variant);
    }
    if (action == "clear") {
        updated = "";
    }
    respond.store_cart(r, updated);

    respond.with_db(c, r, fn(conn: sqlite.Conn) -> Result<Reply, string> {
        Result.Ok(Reply.Json(cart.resolve(conn, updated)?.to_json()))
    });
}

/// Liveness. A database that will not open is 503 (the service is degraded), not 500.
pub fn health(c: Ctx, r: Res) {
    match (database.open()) {
        Result.Err(_) => {
            respond.plain(c, r, Reply.JsonCoded(503, `{"status": "degraded"}`));
        },
        Result.Ok(conn) => {
            let total = match (schema.product_count(conn)) {
                Result.Ok(n) => n,
                Result.Err(_) => 0,
            };
            sqlite.disconnect(conn);
            respond.plain(
                c,
                r,
                Reply.Json(
                    render(obj().field("status", "ok").field("products", total).field("engine", "raylang"))
                )
            );
        },
    }
}
