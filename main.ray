// Nova — an online store served entirely by raylang: the `web/framework` router, SQLite
// for persistence and compiled `.ray.html` templates for the embedded storefront. The
// same process also exposes a JSON API (`/api/...`) that the static Astro frontend and
// its React islands consume.
//
// This file is only the entry point: the catalog lives in `src/store`, the pages in
// `src/http`, and the route table in `src/http/routes.ray`.
//
//   ray run                    serve the store on :8080 (creates and seeds the database
//                              on first run)
//   ray run main.ray reseed    wipe the catalog and seed it again
//   ray dev                    same, with hot reload
//   PORT=9000 ray run          listen somewhere else
//   STORE_DB=/tmp/x.db ray run use another database
from web/framework import listen_graceful, App;
import db/sqlite;
import src/store/database;
import src/store/schema;
import src/http/routes;

// `listen_graceful` takes a plain top-level function, so the route table is reached
// through this one-liner rather than passed as a module-qualified name.
fn build_app() -> App {
    routes.build()
}

/// Creates the tables if they are missing and seeds the catalog if it is empty, so a
/// clean checkout works with a single `ray run`.
fn bootstrap() -> Result<int, string> {
    let conn = database.open()?;
    let total = schema.ensure(conn)?;
    sqlite.disconnect(conn);
    Result.Ok(total)
}

fn reseed() -> Result<int, string> {
    let conn = database.open()?;
    let total = schema.reset(conn)?;
    sqlite.disconnect(conn);
    Result.Ok(total)
}

fn port() -> int {
    match (env("PORT")) {
        Option.Some(value) => {
            match (parse_int(value.trim())) {
                Option.Some(n) => n,
                Option.None => 8080,
            }
        },
        Option.None => 8080,
    }
}

fn main() -> int {
    let arguments = args();
    if (arguments.contains("reseed")) {
        match (reseed()) {
            Result.Ok(total) => {
                print("catalogo regenerado: " + to_string(total) + " productos");
                return 0;
            },
            Result.Err(e) => {
                eprint("reseed: " + e);
                return 1;
            },
        }
    }

    match (bootstrap()) {
        Result.Ok(total) => {
            print("catalogo listo: " + to_string(total) + " productos en " + database.path());
        },
        Result.Err(e) => {
            eprint("arranque: " + e);
            return 1;
        },
    }

    let listening = port();
    print("Nova escuchando en http://127.0.0.1:" + to_string(listening));
    match (listen_graceful(build_app, "127.0.0.1", listening, 5000)) {
        Result.Ok(_) => 0,
        Result.Err(e) => {
            eprint("servidor: " + e);
            1
        },
    }
}
